#!/bin/sh
# claude-sync: two accounts on one Mac share their Claude Code sessions, add-only (Nat, 2026-10-24: one .claude, "sync to each
# other"). Each account runs this as itself and copies the OTHER account's tree into its OWN home; nobody writes into the
# other's home.
#
#   claude-sync /Users/nat/.claude      # as beta: nat's projects/ -> ~/.claude/projects/, nat's backups/ -> ~/.claude/backups/from-nat/
#   claude-sync /Users/beta/.claude     # as nat: the same the other way
#   claude-sync -n /Users/nat/.claude   # dry run
#
# Add-only: no --delete, and --update never replaces a file that is newer here (a session this account resumed and wrote
# to stays this account's). A copied file keeps its mtime and size, so the other side's next run skips it: no ping-pong.
# Reading the other home needs an ACL, e.g. as beta: chmod -R +a "nat allow list,search,readattr,read,file_inherit,directory_inherit" ~/.claude/projects
set -u
DRY=""
[ "${1:-}" = "-n" ] && { DRY=-n; shift; }
FROM=${1:?usage: claude-sync [-n] <the other account .claude>}
TO="${CLAUDE_SYNC_TO:-$HOME/.claude}"
[ "$(cd "$FROM" 2>/dev/null && pwd -P)" = "$(cd "$TO" && pwd -P)" ] && { echo "refuse: $FROM is this account's own home" >&2; exit 2; }
who=$(stat -f %Su "$FROM" 2>/dev/null || stat -c %U "$FROM")
t0=$(date +%s); rc=0
sync1() {   # src dst label [rsync options]
  [ -d "$1" ] || return 0
  src=$1 dst=$2 label=$3; shift 3
  mkdir -p "$dst"
  out=$(rsync -rlt --update $DRY --stats --chmod=Du=rwx,Dgo=,Fu=rw,Fgo= --exclude='.*.tmp' "$@" "$src/" "$dst/" 2>&1)
  r=$?   # 23: some files unreadable (a session the other account is writing right now): the rest went
  [ $r -eq 0 ] || [ $r -eq 23 ] || { echo "$out" | tail -3 >&2; rc=1; }
  n=$(printf '%s\n' "$out" | sed -n -E 's/^Number of (regular )?files transferred: ([0-9,]+).*/\2/p' | tr -d ',')
  printf '%s %s files=%s rc=%s\n' "$(date '+%F %T')" "$label" "${n:-0}" "$r"
}
sync1 "$FROM/projects" "$TO/projects" "projects<-$who"
sync1 "$FROM/backups" "$TO/backups/from-$who" "backups<-$who" --exclude='/from-*'   # never its copy of ours back
echo "$(date '+%F %T') claude-sync from $FROM done in $(( $(date +%s) - t0 ))s rc=$rc${DRY:+ (dry run)}"
exit $rc
