#!/bin/sh
# relic5 push: copy this machine's relic-extract parts to the hub, under parts/<machine>/.
#
#   bin/relic5-push                         # RELIC5_HUB=nat@white.follow-rankine.ts.net, machine = short hostname
#   RELIC5_MACHINE=mba bin/relic5-push      # name the machine yourself (or once: echo mba > ~/.config/relic5/machine)
#   RELIC5_NEW_MACHINE=1 bin/relic5-push    # the first push of a new machine: the hub refuses an unknown name otherwise
#   bin/relic5-push -n                      # dry run: list what would move, send nothing
#
# Ported from agent-relic-v3 hub/push.sh (commit 6a6d9d8). Kept from it: rsync over ssh, -a so mtimes travel
# (an unchanged month is skipped; only grown months move), never --delete on the hub (a part pruned here stays on
# the hub), and the realpath guard (white's /Users/nat is a symlink to /home/nat: a target that resolves
# somewhere else is refused, not merged into). Changed: it sends ~/.relic-extract streams, not raw transcripts,
# and each machine lands in its own folder, so nothing from two machines ever shares a path.
set -u
STAMP=                                          # set by bin/relic5-install on a copy outside this checkout
# What this push sends, as a number: bumped only when the behaviour changes (streams, meta files, _sync.json, local
# hub...). relic_status compares this, not the git hash, which differs after every commit (relic4-scan, 2026-10-23).
PUSH_FORMAT=9
# The ssh target. RELIC5_HUB_SSH wins; RELIC5_HUB may be the hub's HTTP url (relic-chain sets it for its SYNC check):
# then the ssh target is nat@<its host>, not the url.
HUB="${RELIC5_HUB_SSH:-${RELIC5_HUB:-nat@white.follow-rankine.ts.net}}"
case "$HUB" in http://*|https://*) h=${HUB#*://}; h=${h%%/*}; HUB="nat@${h%%:*}";; esac
# RELIC5_HUB=s3://bucket/prefix: the hub lives in a bucket (relic5 store.py). Every step below writes to a local
# staging copy of this machine's folder exactly as it would to a hub over ssh, then only the files whose size or
# mtime changed since the last push go up (aws s3 cp), and each job event is one object (S3 has no append).
# The key is a push-only one (put, list, get; no delete): RELIC5_S3_KEY, default ~/.config/relic5/s3-push.
S3HUB=""
case "$HUB" in s3://*)
  S3HUB="${HUB%/}"
  command -v aws >/dev/null 2>&1 || { echo "an s3:// hub needs the aws CLI" >&2; exit 2; }
  KEYF="${RELIC5_S3_KEY:-$HOME/.config/relic5/s3-push}"
  [ -r "$KEYF" ] || { echo "no S3 key at $KEYF (line 1 the key, line 2 the secret)" >&2; exit 2; }
  AWS_ACCESS_KEY_ID=$(sed -n 1p "$KEYF"); AWS_SECRET_ACCESS_KEY=$(sed -n 2p "$KEYF"); export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
  AWS_DEFAULT_REGION="${RELIC5_S3_REGION:-black-ssd-rustfs}"; export AWS_DEFAULT_REGION
  EP="${RELIC5_S3_ENDPOINT:-http://black.follow-rankine.ts.net:9200}"
  STAGE="${RELIC5_STAGE:-$HOME/.cache/relic5/push-stage}"
  mkdir -p "$STAGE" && STAGE=$(cd "$STAGE" && pwd -P)   # its real path: the symlink guard below compares real paths
  HUB=local ;;
esac
s3() { aws --endpoint-url "$EP" s3 "$@"; }
SRC="${RELIC5_SRC:-$HOME/.relic-extract}"
DEST="${RELIC5_DEST:-relic5/parts}"            # relative to the hub user's home
# The name: RELIC5_MACHINE, else ~/.config/relic5/machine (one line, written once per machine), else the short hostname.
# 2026-10-25: a push run by hand on the MacBook Air took its hostname and opened parts/nats-macbook-air beside mba.
NAMEFILE="${RELIC5_MACHINE_FILE:-$HOME/.config/relic5/machine}"
MACHINE="${RELIC5_MACHINE:-$( [ -s "$NAMEFILE" ] && head -1 "$NAMEFILE" | tr -d ' \n' || hostname -s | tr 'A-Z' 'a-z')}"
STREAMS="${RELIC5_STREAMS:-text thinking tools vault}"
DRY=""
[ "${1:-}" = "-n" ] && DRY="-n"

case "$MACHINE" in *[!a-z0-9-]*|"") echo "bad machine name: '$MACHINE'" >&2; exit 2;; esac
[ -d "$SRC" ] || { echo "no $SRC" >&2; exit 2; }
# relic-extract holds an flock on $SRC/.lock for its whole run (relic-extract src/run.rs). Hold a shared one for
# the push: no push while it cuts, and it waits for a push in flight. Busy now = exit 75, try after the run.
if [ -z "${RELIC5_LOCKED:-}" ] && [ -e "$SRC/.lock" ]; then
  RELIC5_LOCKED=1 exec perl -MFcntl=:flock -e '$^F = 255; open(my $f, "<", shift) or die "lock: $!\n";
    flock($f, LOCK_SH | LOCK_NB) or do { print STDERR "relic-extract is running; push later\n"; exit 75 };
    exec @ARGV or die "exec: $!\n"' "$SRC/.lock" "$0" "$@"
fi
SSH="ssh -o BatchMode=yes -o ConnectTimeout=10"
# RELIC5_HUB=local: this machine is the hub (white pushing its own parts): same rsync, no ssh to itself.
if [ "$HUB" = local ]; then R=""; on_hub() { sh -c "$1"; }; else R="$HUB:"; on_hub() { $SSH "$HUB" "$1"; }; fi

home=$(on_hub 'printf %s "$HOME"') || { echo "cannot reach $HUB" >&2; exit 1; }
[ -n "$S3HUB" ] && { home="$STAGE"; DEST=parts; }
target="$home/$DEST/$MACHINE"
known() {   # does the hub hold this machine already?
  if [ -n "$S3HUB" ]; then [ -n "$(s3 ls "$S3HUB/parts/$MACHINE/" 2>/dev/null | head -1)" ]; else on_hub "test -d '$target'"; fi
}
# A machine the hub has never seen is a new folder for good: only on purpose (RELIC5_NEW_MACHINE=1), never by a
# hostname fallback.
if [ -z "${RELIC5_NEW_MACHINE:-}" ] && ! known; then
  echo "refuse: the hub has no machine '$MACHINE' yet. Name this machine (RELIC5_MACHINE=<name>, or put the name in $NAMEFILE)," >&2
  echo "        or start a new one on purpose with RELIC5_NEW_MACHINE=1." >&2
  exit 2
fi
real=$(on_hub "mkdir -p '$target' && realpath '$target'") || exit 1
[ "$real" = "$target" ] || { echo "refuse: on $HUB $target resolves to $real" >&2; exit 1; }

# One line per stream from rsync --stats: GNU rsync says "Number of regular files transferred" / "Total bytes sent",
# macOS openrsync "Number of files transferred" / "Total sent: 159 B".
report() {
  files=$(printf '%s\n' "$2" | sed -n -E 's/^Number of (regular )?files transferred: ([0-9,]+).*/\2/p' | tr -d ',')
  sent=$(printf '%s\n' "$2" | sed -n -E 's/^Total (bytes )?sent: ([0-9,]+).*/\2/p' | tr -d ',')
  printf 'stream %-8s files=%s sent=%s\n' "$1" "${files:-0}" "${sent:-0}"
  sent_total=$((sent_total + ${sent:-0}))
}
# The push as a job in the hub's logs/jobs.jsonl (relic3 JobEvent): start now, done or error at the end.
JOB="push-$MACHINE-$(date -u +%Y%m%d-%H%M%S)-$$"
jobev() {   # state, extra JSON fields (no leading comma)
  [ -n "$DRY" ] && return 0
  line=$(printf '{"job": "%s", "verb": "push", "state": "%s", "at": "%s", "pid": %s, "host": "%s", "message": "machine %s"%s}' \
    "$JOB" "$1" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$$" "$(hostname -s)" "$MACHINE" "${2:+, $2}")
  if [ -n "$S3HUB" ]; then   # one object per event, named by time like store.append_line, so a listing reads in order
    ns=$(python3 -c 'import time; print(f"{time.time_ns():020d}")' 2>/dev/null || printf '%010d000000000' "$(date +%s)")
    printf '%s\n' "$line" | s3 cp - "$S3HUB/logs/jobs.jsonl.d/$ns-$(hostname -s)-$$.jsonl" --only-show-errors || true
    return 0
  fi
  on_hub "mkdir -p \"\$HOME/relic5/logs\" && printf '%s\\n' '$line' >> \"\$HOME/relic5/logs/jobs.jsonl\"" || true
}
jobev start
rc=0
t0=$(date +%s)
sent_total=0
for s in $STREAMS; do
  [ -d "$SRC/$s" ] || continue
  # --stats is parsed into one line per stream: files sent, bytes sent.
  out=$(rsync -a $DRY --timeout=120 --stats --exclude='.*' "$SRC/$s/" "$R$target/$s/" 2>&1) || { echo "$out" >&2; rc=1; continue; }
  report "$s" "$out"
done
# relic-scan's session table: repo, tier and the subagent tree for relic_sessions / relic_session.
# Plus months.json, relic-scan's per-month manifest (rows, first/max ts, keys, late rows; relic4-scan PR #35).
# Plus vaults.json, what each ψ note's "vault:<id>" means (oracle name, path: relic5 vaults.py).
SCAN="${RELIC5_SCAN:-$HOME/.relic-scan}/meta"
META=$(for f in sessions.parquet months.json vaults.json; do [ -f "$SCAN/$f" ] && printf '%s ' "$SCAN/$f"; done)
if [ -n "$META" ] && on_hub "mkdir -p '$target/meta'"; then   # openrsync (macOS) has no --mkpath
  out=$(rsync -a $DRY --timeout=120 --stats $META "$R$target/meta/" 2>&1) || { echo "$out" >&2; rc=1; }
  report meta "$out"
fi
# The fleet's lineage, when this machine holds mother-oracle: its newest frozen scan (registry/lineage/vN_<date>_scan.json,
# /oracle-lineage-scan: who budded from whom, born when) as meta/lineage.json, for the hub's Family view.
LIN=$(ls -t "$(ghq root 2>/dev/null || echo "$HOME/Code")"/github.com/laris-co/mother-oracle/registry/lineage/v*_scan.json 2>/dev/null | head -1)
if [ -n "$LIN" ] && on_hub "mkdir -p '$target/meta'"; then
  rsync -a $DRY --timeout=60 "$LIN" "$R$target/meta/lineage.json" >/dev/null 2>&1 || rc=1
fi
# Seal receipts (relic5 sealday.py): for every month relic-scan sealed, the sha256 and size of each extracted part
# as this machine holds it, so the hub can prove its copy is byte-identical before it reconciles the month. Hashes
# are cached by size + mtime in $SRC/.receipts-cache.json: an unchanged sealed month costs nothing the next time.
if [ -f "$SCAN/months.json" ] && command -v python3 >/dev/null 2>&1; then
  python3 - "$SCAN/months.json" "$SRC" "$MACHINE" "$STREAMS" > "${TMPDIR:-/tmp}/relic5-receipts.$$" <<'PY' && \
    { [ -n "$DRY" ] || rsync -a --timeout=60 "${TMPDIR:-/tmp}/relic5-receipts.$$" "$R$target/meta/receipts.json" >/dev/null 2>&1 || rc=1; }
import hashlib, json, os, sys, time
months_p, src, machine, streams = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4].split()
cache_p = os.path.join(src, ".receipts-cache.json")
try:
    cache = json.load(open(cache_p))
except (OSError, ValueError):
    cache = {}
out = {"version": 1, "machine": machine, "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "months": {}}
for m in json.load(open(months_p)).get("months", []):
    if not (m.get("sealed") and m.get("sealed_keys")):
        continue
    parts = {}
    for s in streams:
        p = os.path.join(src, s, m["month"] + ".parquet")
        if not os.path.isfile(p):
            continue
        st = os.stat(p)
        c = cache.get(p)
        if not c or c[0] != st.st_size or c[1] != int(st.st_mtime):
            h = hashlib.sha256()
            with open(p, "rb") as f:
                for b in iter(lambda: f.read(1 << 20), b""):
                    h.update(b)
            c = cache[p] = [st.st_size, int(st.st_mtime), h.hexdigest()]
        parts[s] = {"bytes": c[0], "sha256": c[2]}
    out["months"][m["month"]] = {"sealed_keys": m["sealed_keys"], "sealed_rows": m.get("sealed_rows"), "parts": parts}
json.dump(cache, open(cache_p + ".tmp", "w"))
os.replace(cache_p + ".tmp", cache_p)
print(json.dumps(out))
PY
  rm -f "${TMPDIR:-/tmp}/relic5-receipts.$$"
fi
# Claude Code's memory notes, raw (relic5 memory.py makes them the "memory" search layer): every
# ~/.claude*/projects/<project>/memory/*.md -> parts/<machine>/memory/<home>/<project>/memory/. relic-scan reads only
# .jsonl and ψ vaults, so without this the one-fact rules and decisions of every project were nowhere (Nat, 2026-10-24).
# RELIC5_MEMORY_ROOTS (space-separated) adds homes this account does not own, e.g. another user's export
# (/Users/Shared/nat-export/.claude, 2026-10-24: nat's notes, m5-nat retired). Their folder on the hub is
# <parent>-<home> (nat-export-claude), so they never land on top of this account's "claude".
for H in "$HOME"/.claude "$HOME"/.claude-* ${RELIC5_MEMORY_ROOTS:-}; do
  [ -d "$H/projects" ] || continue
  name=$(basename "$H" | sed 's/^\.//')
  case " ${RELIC5_MEMORY_ROOTS:-} " in *" $H "*) name="$(basename "$(dirname "$H")")-$name" ;; esac
  [ -z "$DRY" ] && { on_hub "mkdir -p '$target/memory/$name'" || { rc=1; continue; }; }
  out=$(rsync -a $DRY --timeout=120 --stats --prune-empty-dirs --include='*/' --include='*/memory/*.md' --exclude='*' \
    "$H/projects/" "$R$target/memory/$name/" 2>&1) || { echo "$out" >&2; rc=1; continue; }
  report "memory:$name" "$out"
done
# Config files, raw (relic5 config.py makes them the "config" search layer, issue #269): where a rule is enforced, not
# only remembered. Per account: ~/.claude*/CLAUDE.md and AGENTS.md, ~/.codex/AGENTS.md, every SKILL.md under
# ~/.claude*/skills and ~/.claude*/plugins/cache; the ghq tree's own CLAUDE.md / AGENTS.md (the root, each host, each
# org: in no repo) and every CLAUDE.md / AGENTS.md git knows in a repo of `ghq list`. Copied into a fresh staging folder
# (~/.cache/relic5/config/<user>), then -> parts/<machine>/config/<user>/, with _files.json listing what was sent.
# Only those three file names are read; settings.json, .envrc, .env*, *.pem, *.key, *.conf never are. A file holding
# anything key-shaped is refused whole before it leaves the machine (the same check as relic5 config.key_shaped; the
# block between the KEY_SHAPED markers is kept identical, tests/test_config.py compares them). RELIC5_CONFIG=0: off;
# RELIC5_CONFIG_STAGE moves the staging folder.
if [ "${RELIC5_CONFIG:-1}" != 0 ] && command -v python3 >/dev/null 2>&1; then
  CUSER=$(id -un | tr 'A-Z' 'a-z')
  CSTAGE="${RELIC5_CONFIG_STAGE:-$HOME/.cache/relic5/config}/$CUSER"
  case "$CUSER" in *[!a-z0-9_-]*|"") echo "config: bad account name '$CUSER'" >&2; rc=1;; *)
  # GNU stat first (see the git block below). Re-collected at most every RELIC5_CONFIG_EVERY seconds (default 3600:
  # a full pass reads every repo's file list, 35 s on m5's 1,334 repos); between, the staged copy is sent as it is.
  cage=$(( $(date +%s) - $(stat -c %Y "$CSTAGE/_files.json" 2>/dev/null || stat -f %m "$CSTAGE/_files.json" 2>/dev/null || echo 0) ))
  if [ "$cage" -lt "${RELIC5_CONFIG_EVERY:-3600}" ] || python3 - "$CSTAGE" "$(ghq root 2>/dev/null || true)" "$HOME" <<'PY'; then
import json, math, os, re, shutil, subprocess, sys, time
stage, groot, home = sys.argv[1], sys.argv[2], sys.argv[3]
NAMES = ("CLAUDE.md", "AGENTS.md", "SKILL.md")
# KEY_SHAPED begin
_VAL = r"[\"']?(?=[\w~+/=-]*\d)(?=[\w~+/=-]*[A-Za-z])[\w~+/=-]{16,}(?![\w.~+/=-])"
KEY_SHAPED = [
    ("private-key-block", re.compile(r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----")),
    ("wireguard-key", re.compile(r"(?im)^\s*(?:PrivateKey|PresharedKey)\s*=\s*[A-Za-z0-9+/]{42,43}=")),
    ("github-token", re.compile(r"\b(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,})")),
    ("api-key", re.compile(r"\bsk-(?:ant-|proj-)?[A-Za-z0-9_-]{24,}")),
    ("slack-token", re.compile(r"\bxox[abprs]-[A-Za-z0-9-]{10,}")),
    ("aws-key", re.compile(r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b")),
    ("google-key", re.compile(r"\bAIza[0-9A-Za-z_-]{35}\b")),
    ("jwt", re.compile(r"\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}")),
    ("bearer", re.compile(r"(?i)\bbearer\s+" + _VAL)),
    ("secret-assigned", re.compile(r"(?i)\b(?:api[_-]?key|secret|token|password|passwd|client[_-]?secret|access[_-]?key)"
                                   r"\b[\"']?\s*[:=]\s*" + _VAL)),
]
_RUN = re.compile(r"[A-Za-z0-9+/]{24,}")


def _entropy(s: str) -> float:
    n = len(s)
    return -sum(c / n * math.log2(c / n) for c in (s.count(ch) for ch in set(s)))


def key_shaped(text: str) -> "str | None":
    for name, rx in KEY_SHAPED:
        m = rx.search(text)
        if m:
            return f"{name} line {text.count(chr(10), 0, m.start()) + 1}"
    for m in _RUN.finditer(text):
        s = m.group(0).strip("/")
        if (m.start() and text[m.start() - 1] == "/") or "/" in s and "://" in text[max(0, m.start() - 200):m.start()]:
            continue   # a URL's path segment, not a value
        if len(s) >= 24 and any(c.isupper() for c in s) and any(c.islower() for c in s) and any(c.isdigit() for c in s) \
                and _entropy(s) >= 4.2:
            return f"high-entropy line {text.count(chr(10), 0, m.start()) + 1}"
    return None
# KEY_SHAPED end
want = []   # (source, rel under the stage)


def walk(top, rel):   # every SKILL.md under top; follows symlinked skill folders once each
    seen = set()
    for d, dirs, fs in os.walk(top, followlinks=True):
        r = os.path.realpath(d)
        if r in seen:
            dirs[:] = []
            continue
        seen.add(r)
        dirs[:] = [x for x in dirs if not x.startswith(".") and x != "node_modules"]
        if "SKILL.md" in fs:
            want.append((os.path.join(d, "SKILL.md"), os.path.join(rel, os.path.relpath(d, top), "SKILL.md")))


for h in sorted(os.listdir(home)):
    H = os.path.join(home, h)
    if not (h == ".codex" or h == ".claude" or h.startswith(".claude-")) or not os.path.isdir(H):
        continue
    base = os.path.join("home", h[1:])
    for n in ("CLAUDE.md", "AGENTS.md"):
        if os.path.isfile(os.path.join(H, n)):
            want.append((os.path.join(H, n), os.path.join(base, n)))
    if os.path.isdir(os.path.join(H, "skills")):
        walk(os.path.join(H, "skills"), os.path.join(base, "skills"))
    if os.path.isdir(os.path.join(H, "plugins", "cache")):
        walk(os.path.join(H, "plugins", "cache"), os.path.join(base, "plugins", "cache"))
if groot and os.path.isdir(groot):
    repos = subprocess.run(["ghq", "list"], capture_output=True, text=True).stdout.split()
    dirs = {""}
    for r in repos:
        p = r.split("/")
        if p[0].startswith(("_", ".")):
            continue   # _archive/, .rescue-husks-*/: copies listed again under their host
        dirs |= {p[0], "/".join(p[:2])}
    for d in sorted(dirs):
        for n in ("CLAUDE.md", "AGENTS.md"):
            src = os.path.join(groot, d, n)
            if os.path.isfile(src):
                want.append((src, os.path.join("ghq", d, n)))
    for r in repos:
        if r.split("/")[0].startswith(("_", ".")):
            continue
        top = os.path.join(groot, r)
        out = subprocess.run(["git", "-C", top, "ls-files", "-z", "--cached", "--others", "--exclude-standard", "--",
                              ":(glob)**/CLAUDE.md", ":(glob)**/AGENTS.md"], capture_output=True, text=True).stdout
        for f in sorted(set(x for x in out.split("\0") if x)):
            if os.path.basename(f) in NAMES and not f.startswith(("wt/", "node_modules/")) and "/node_modules/" not in f:
                if os.path.isfile(os.path.join(top, f)):
                    want.append((os.path.join(top, f), os.path.join("ghq", r, f)))
shutil.rmtree(stage, ignore_errors=True)   # our own staging copy: rebuilt every push, so a removed file goes too
os.makedirs(stage)
sent, refused = [], []
for src, rel in want:
    try:
        if os.path.getsize(src) > 1 << 20:
            refused.append({"rel": rel, "why": "over 1 MB"})
            continue
        text = open(src, encoding="utf-8", errors="replace").read()
    except OSError:
        continue
    why = key_shaped(text)
    if why:
        refused.append({"rel": rel, "why": why})
        continue
    dst = os.path.join(stage, rel)
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    shutil.copy2(src, dst)
    sent.append(rel)
json.dump({"files": sorted(set(sent)), "refused": refused, "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())},
          open(os.path.join(stage, "_files.json"), "w"), indent=1)
for r in refused:
    print(f"config refused {r['rel']}: {r['why']}", file=sys.stderr)
PY
    if [ -n "$DRY" ] || on_hub "mkdir -p '$target/config/$CUSER'"; then
      out=$(rsync -a $DRY --timeout=120 --stats "$CSTAGE/" "$R$target/config/$CUSER/" 2>&1) || { echo "$out" >&2; rc=1; }
      report "config:$CUSER" "$out"
    fi
  else rc=1; fi ;;
  esac
fi
# Git commits, raw (relic5 gitlog.py makes them the "git" search layer): the work from before any transcript survived.
# Claude Code co-wrote commits from 2025-03-25, but the oldest transcript left is 2025-09-19 (Claude Code deletes
# transcripts after 30 days by default). One `git log --all` per repo of `ghq list` -> parts/<machine>/git/<host>/<org>/<repo>.log,
# fields split by 0x1f, commits by 0x1e. Re-read at most every RELIC5_GIT_EVERY seconds (default 3600), and a repo only
# when its refs moved, so a push between costs nothing. RELIC5_GIT=0 turns it off.
GITC="${RELIC5_GIT_CACHE:-$HOME/.cache/relic5/git}"
if [ "${RELIC5_GIT:-1}" != 0 ] && command -v ghq >/dev/null 2>&1; then
  mkdir -p "$GITC"
  # GNU first: on Linux `stat -f` is filesystem info and exits 0, so BSD-first fed that into $(( )) (white, 2026-10-24 20:09)
  age=$(( $(date +%s) - $(stat -c %Y "$GITC/.stamp" 2>/dev/null || stat -f %m "$GITC/.stamp" 2>/dev/null || echo 0) ))
  if [ "$age" -ge "${RELIC5_GIT_EVERY:-3600}" ]; then
    groot=$(ghq root)
    ghq list -p | while IFS= read -r repo; do
      rel=${repo#"$groot"/}
      case "$rel" in _*|.*) continue;; esac   # _archive/, .rescue-husks-*/: copies of repos listed again under their host
      # always <host>/<org>/<repo>: mba's ghq root is ~/Code/github.com, so its list has no host
      case "$rel" in *.*/*/*) ;; */*) case "$groot" in */*.*) rel="${groot##*/}/$rel";; esac;; esac
      out="$GITC/$rel.log"
      refs=$(git -C "$repo" for-each-ref --format='%(objectname)' 2>/dev/null | cksum)
      [ -f "$out" ] && [ "$(cat "$out.refs" 2>/dev/null)" = "$refs" ] && continue
      mkdir -p "$(dirname "$out")"
      if git -C "$repo" log --all --no-merges --format='%H%x1f%aI%x1f%cI%x1f%an%x1f%ae%x1f%s%x1f%b%x1e' > "$out.tmp" 2>/dev/null; then
        mv "$out.tmp" "$out" && printf '%s\n' "$refs" > "$out.refs"
      else
        rm -f "$out.tmp"   # no commits yet, or not a repo
      fi
    done
    touch "$GITC/.stamp"
  fi
  if [ -n "$DRY" ] || on_hub "mkdir -p '$target/git'"; then
    out=$(rsync -a $DRY --timeout=120 --stats --exclude='.*' --exclude='*.refs' --exclude='*.tmp' "$GITC/" "$R$target/git/" 2>&1) \
      || { echo "$out" >&2; rc=1; }
    report git "$out"
  fi
fi
# Discord backups, text only (relic5 discord.py makes them the "discord" layer, kept off the public MCP): the servers
# neo's ~/.maw/atlas-blobs/manifest.json marks verified, one ~/.cache/relic5/discord/<guild>.jsonl.gz each
# (bin/relic5-discord-export, re-read only when a backup changed) -> parts/<machine>/discord/. Only on a machine that
# holds maw atlas backups; RELIC5_DISCORD=0 turns it off.
DISC="${RELIC5_DISCORD_CACHE:-$HOME/.cache/relic5/discord}"
if [ "${RELIC5_DISCORD:-1}" != 0 ] && [ -f "${ATLAS_BLOBS:-$HOME/.maw/atlas-blobs}/manifest.json" ]; then
  [ -n "$DRY" ] || RELIC5_DISCORD_CACHE="$DISC" "$(dirname "$0")/relic5-discord-export" | tail -1 || rc=1
  if [ -d "$DISC" ] && { [ -n "$DRY" ] || on_hub "mkdir -p '$target/discord'"; }; then
    out=$(rsync -a $DRY --timeout=120 --stats --exclude='.*' --exclude='*.stamp' --exclude='*.tmp' "$DISC/" "$R$target/discord/" 2>&1) \
      || { echo "$out" >&2; rc=1; }
    report discord "$out"
  fi
fi
# What this machine runs, so the hub can tell when machines differ (relic_status warns on a mismatch).
ver() { command -v "$1" >/dev/null 2>&1 && "$1" --version 2>/dev/null | head -1 | sed 's/^[^ ]* //' || echo none; }
here=${STAMP:-$(cd "$(dirname "$0")" && git log -1 --format=%h -- relic5-push 2>/dev/null)}; here=${here:-unknown}   # the commit that last changed this file
printf '{"machine": "%s", "at": "%s", "relic-scan": "%s", "relic-extract": "%s", "relic5-push": "%s", "push-format": %s, "os": "%s"}\n' \
  "$MACHINE" "$(date '+%FT%T%z')" "$(ver relic-scan)" "$(ver relic-extract)" "$here" "$PUSH_FORMAT" "$(uname -sm)" > "${TMPDIR:-/tmp}/relic5-versions.$$"
[ -z "$DRY" ] && rsync -a --timeout=60 "${TMPDIR:-/tmp}/relic5-versions.$$" "$R$target/_versions.json" >/dev/null 2>&1 || true
rm -f "${TMPDIR:-/tmp}/relic5-versions.$$"
# The newest SYNC line of this machine's relic-chain log (relic4-scan's loop), for the hub's Sync card.
for L in "${RELIC5_CHAIN_LOG:-}" "$HOME/Library/Logs/relic-chain.log" "$HOME/.local/state/relic-chain.log"; do
  [ -n "$L" ] && [ -f "$L" ] || continue
  line=$(grep -E "SYNC (OK|MISMATCH)" "$L" | tail -1 | tr -d '"\\')
  [ -n "$line" ] && [ -z "$DRY" ] && printf '{"line": "%s", "log": "%s"}\n' "$line" "$L" > "${TMPDIR:-/tmp}/relic5-sync.$$" \
    && rsync -a --timeout=60 "${TMPDIR:-/tmp}/relic5-sync.$$" "$R$target/_sync.json" >/dev/null 2>&1
  rm -f "${TMPDIR:-/tmp}/relic5-sync.$$"
  break
done
# An S3 hub: send what changed in the staging copy since the last push (size or mtime), file by file.
if [ -n "$S3HUB" ] && [ -z "$DRY" ]; then
  MAN="$STAGE/.uploaded-$MACHINE.tsv"; OK="${TMPDIR:-/tmp}/relic5-up.$$"; : > "$OK"
  python3 - "$target" "$MAN" > "${TMPDIR:-/tmp}/relic5-changed.$$" <<'PY'
import os, sys
base, man = sys.argv[1], sys.argv[2]
done = {}
try:
    for line in open(man):
        rel, size, mtime = line.rstrip("\n").split("\t")
        done[rel] = (size, mtime)
except OSError:
    pass
for d, _, fs in os.walk(base):
    for f in fs:
        if f.startswith("."):
            continue
        p = os.path.join(d, f); st = os.stat(p); rel = os.path.relpath(p, base)
        if done.get(rel) != (str(st.st_size), str(int(st.st_mtime))):
            print(f"{rel}\t{st.st_size}\t{int(st.st_mtime)}")
PY
  up=0
  while IFS="$(printf '\t')" read -r rel size mtime; do
    [ -n "$rel" ] || continue
    if s3 cp "$target/$rel" "$S3HUB/parts/$MACHINE/$rel" --only-show-errors; then
      printf '%s\t%s\t%s\n' "$rel" "$size" "$mtime" >> "$OK"; up=$((up + 1)); sent_total=$((sent_total + size))
    else rc=1; fi
  done < "${TMPDIR:-/tmp}/relic5-changed.$$"
  python3 - "$MAN" "$OK" <<'PY'
import sys
man, ok = sys.argv[1], sys.argv[2]
rows = {}
for p in (man, ok):
    try:
        for line in open(p):
            r = line.rstrip("\n").split("\t")
            if len(r) == 3:
                rows[r[0]] = r
    except OSError:
        pass
open(man + ".tmp", "w").write("".join("\t".join(r) + "\n" for r in sorted(rows.values())))
import os; os.replace(man + ".tmp", man)
PY
  rm -f "$OK" "${TMPDIR:-/tmp}/relic5-changed.$$"
  printf 's3 %s: %s files changed, sent\n' "$S3HUB/parts/$MACHINE" "$up"
  HUB="$S3HUB"; target="parts/$MACHINE"
fi
if [ $rc -eq 0 ]; then jobev done "\"rc\": 0, \"done\": $sent_total, \"unit\": \"bytes\""; else jobev error "\"rc\": $rc"; fi
printf '%s relic5 push %s -> %s:%s rc=%s %ss%s\n' "$(date '+%F %T')" "$MACHINE" "$HUB" "$target" "$rc" \
  "$(( $(date +%s) - t0 ))" "${DRY:+ (dry run)}"
exit $rc
