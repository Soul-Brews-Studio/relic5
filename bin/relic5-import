#!/usr/bin/env bun
// relic5-import: push this machine's Claude/Codex history to the relic5 hub ONCE, by hand.
// Nat, 2026-10-26: "we just do manual". No loop, no launchd job: run it when the hub should catch up.
// The same steps as ~/.local/bin/relic-chain (relic-scan run, relic-extract run, relic5-push, relic5 embed, SYNC
// check), written with Bun.$ and drawn like relic-scan: its own live scan, then each stage with a spinner and its time,
// then one box with what the hub now holds for this machine. Exit 0 = every stage ran and the hub agrees.
//   RELIC5_MACHINE=m5 bin/relic5-import
// RELIC5_MACHINE is required (the name the hub knows this machine by; a wrong name files the rows under another
// machine, see docs/RETIRED.md m5-nat). RELIC5_HUB_URL defaults to white. See docs/IMPORT.md.
import { $ } from "bun";
import { appendFileSync, existsSync, readFileSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, join } from "node:path";

const M = process.env.RELIC5_MACHINE;
if (!M) { console.error("set RELIC5_MACHINE (m5, mba, white ...)"); process.exit(2); }
const HUB = process.env.RELIC5_HUB_URL ?? "http://white.follow-rankine.ts.net:8795";
const HOME = homedir();
const PUSH = join(dirname(Bun.main), "relic5-push");
const LOG = process.env.RELIC_CHAIN_LOG ?? join(HOME, "Library/Logs/relic-chain.log");

const env: Record<string, string> = {
  ...(process.env as Record<string, string>),
  PATH: [`${HOME}/.local/bin`, `${HOME}/.cargo/bin`, "/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin", process.env.PATH ?? ""].join(":"),
  RELIC5_MACHINE: M,
  RELIC5_HUB_URL: HUB,
};
delete env.RELIC5_HUB; // relic5-push reads RELIC5_HUB as its ssh target, not this URL
if (existsSync("/Users/Shared/nat-export/.claude/projects")) env.RELIC5_MEMORY_ROOTS ??= "/Users/Shared/nat-export/.claude";
$.env(env);

// relic-scan's palette
const rgb = (r: number, g: number, b: number) => (s: string) => `\x1b[38;2;${r};${g};${b}m${s}\x1b[0m`;
const pink = rgb(255, 60, 172), cyan = rgb(0, 214, 255), grey = rgb(128, 136, 156), amber = rgb(245, 183, 59), red = rgb(255, 90, 90);
const bold = (s: string) => `\x1b[1m${s}\x1b[0m`;
const n = (x: number) => x.toLocaleString("en-US");
const stamp = () => new Date().toLocaleString("sv-SE").slice(0, 19);
const log = (line: string) => appendFileSync(LOG, line.endsWith("\n") ? line : line + "\n");
const since = (t: number) => `${((performance.now() - t) / 1000).toFixed(1)}s`;

const t0 = performance.now(), startEpoch = Math.floor(Date.now() / 1000);
let fails = 0;

// run one stage under a spinner; its output goes to the log, its last line shows on failure
async function stage(name: string, run: () => Promise<{ exitCode: number; text: string }>) {
  const t = performance.now(), frames = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏";
  let i = 0;
  process.stdout.write("\x1b[?25l");
  const spin = setInterval(() => process.stdout.write(`\r\x1b[2K  ${pink(name.padEnd(7))} ${cyan(frames[i++ % 10])} ${grey(since(t))}`), 100);
  const r = await run();
  clearInterval(spin);
  if (r.text) log(r.text);
  if (r.exitCode === 0) process.stdout.write(`\r\x1b[2K  ${pink(name.padEnd(7))} ${cyan("✓")} ${grey(since(t))}\n`);
  else {
    fails++;
    const last = r.text.trim().split("\n").at(-1) ?? "";
    process.stdout.write(`\r\x1b[2K  ${pink(name.padEnd(7))} ${red(`✗ rc=${r.exitCode}`)} ${grey(since(t))}  ${last}\n`);
  }
  process.stdout.write("\x1b[?25h");
  return r;
}
const sh = async (p: ReturnType<typeof $>) => {
  const r = await p.nothrow().quiet();
  return { exitCode: r.exitCode, text: r.stdout.toString() + r.stderr.toString() };
};
process.on("exit", () => process.stdout.write("\x1b[?25h"));

console.log(grey(`${stamp()} relic5 import (${M} -> ${HUB})`));
// the log keeps relic-chain's line format, so `relic-scan ops` reads a manual import as a pass (relic4-scan, 2026-10-26)
log(`${stamp()} chain start (${M})`);

// 1. relic-scan draws itself on the terminal
const scanRc = (await Bun.spawn(["relic-scan", "run"], { env, stdio: ["inherit", "inherit", "inherit"] }).exited);
if (scanRc !== 0) fails++;
// its summary: one JSON line per run in _scans.jsonl (job "index"; dry runs carry another job)
type Scan = { job: string; at: number; new: number; grown: number; rewritten: number; gone: number; scan_secs: number; secs: number; sessions: number; rows: number };
let scan: Scan | undefined;
try {
  for (const line of readFileSync(join(HOME, ".relic-scan/_scans.jsonl"), "utf8").split("\n")) {
    try { const j = JSON.parse(line) as Scan; if (j.job === "index" && j.at >= startEpoch - 1) scan = j; } catch {}
  }
} catch {}
const scanLine = scan
  ? `scan ${scan.scan_secs.toFixed(1)}s · new ${scan.new} · grown ${scan.grown} · rewritten ${scan.rewritten} · gone ${scan.gone} · ${n(scan.sessions)} sessions · ${n(scan.rows)} rows`
  : `scan rc=${scanRc}: no summary line from this run`;
if (scan) log(`run: ${scanLine}\nrun: done in ${scan.secs.toFixed(1)}s`);
console.log();

// 2. extract (its after hook pushes and asks the hub to index), 3. push again so the hub's versions refresh,
// 4. embed what has no vector yet (AC power only)
const ex = await stage("extract", () => sh($`relic-extract run`));
const cut = ex.text.match(/\d+ part\(s\) cut[^·]*· [\d,]+ chunks/g)?.at(-1) ?? "0 parts cut";
await stage("push", () => sh($`${PUSH}`));
let emb = "embed skipped (battery)";
if ((await $`pmset -g batt`.nothrow().quiet().text()).includes("AC Power") && Bun.which("relic5", { PATH: env.PATH })) {
  const e = await stage("embed", () => sh($`relic5 embed --limit 20000`));
  emb = e.text.match(/embed: [\d,]+ chunks[^-]*/g)?.at(-1)?.replace(/^embed: /, "embedded ").trim() ?? "embed: nothing new";
}
log(`${stamp()} chain end`);

// 5. sync: this machine's counts against the hub's, until they agree (the hub may still be indexing). Both sides are
// read again on every try: another scan or extract may run beside this one.
const STREAMS = ["text", "thinking", "tools"] as const;
async function mine() {
  // relic-extract status --json (relic-extract#45): {"streams":{"text":{"chunks":N,...},...}}
  // A stream with no parts reads chunks 0; an unreadable one carries "error" instead of counts, and is left out (shows
  // as "?"), so it never compares equal to the hub.
  try {
    const j = JSON.parse(await $`relic-extract status --json`.quiet().text());
    const c: Record<string, number> = {};
    for (const s of STREAMS) if (j.streams?.[s] && !j.streams[s].error) c[s] = j.streams[s].chunks;
    return c;
  } catch {}
  // older relic-extract: parse the table
  const out = (await $`relic-extract status`.nothrow().quiet().text()).replace(/\x1b\[[0-9;]*m/g, "");
  const c: Record<string, number> = {};
  for (const l of out.split("\n")) {
    const f = l.trim().split(/\s+/), k = f.indexOf("chunks");
    if (STREAMS.includes(f[0] as any) && k > 0) c[f[0]] = Number(f[k - 1].replaceAll(",", ""));
  }
  return c;
}
async function hub() {
  try { return await (await fetch(`${HUB}/api/status`, { signal: AbortSignal.timeout(20_000) })).json() as any; } catch { return undefined; }
}
const fmt = (c: Record<string, number>) => STREAMS.map((s) => `${s}|${c[s] ?? "?"}`).join(" ");
let want: Record<string, number> = {}, got: Record<string, number> = {}, status: any;
const sync = await stage("sync", async () => {
  for (let i = 0; i < 18; i++) {
    [want, status] = await Promise.all([mine(), hub()]);
    const m = status?.machines?.[M];
    got = m ? Object.fromEntries(STREAMS.map((s) => [s, m[s]?.rows])) : {};
    if (fmt(want) === fmt(got)) return { exitCode: 0, text: "" };
    await Bun.sleep(10_000);
  }
  return { exitCode: 1, text: `${M}: ${fmt(want)}  hub: ${status ? fmt(got) : "unreachable"}` };
});
log(sync.exitCode === 0 ? `${stamp()} SYNC OK  ${fmt(got)}` : `${stamp()} SYNC MISMATCH  ${M}: ${fmt(want)}  hub: ${fmt(got)}`);

// the box
const f = (await hub())?.freshness?.machines?.[M] ?? {};
const ok = fails === 0 && sync.exitCode === 0;
const lines = [
  `hub ${M} · text ${n(got.text ?? 0)} · thinking ${n(got.thinking ?? 0)} · tools ${n(got.tools ?? 0)}`,
  scanLine,
  `${cut} · ${emb}`,
  `pushed ${String(f.pushed_at ?? "?").slice(11, 19)} · newest ${String(f.newest_ts ?? "?").slice(0, 19).replace("T", " ")} UTC · lag ${f.lag_s ?? "?"}s`,
  `${sync.exitCode === 0 ? "sync OK" : `sync MISMATCH: ${M} ${fmt(want)}`} · total ${since(t0)}`,
  `▸ relic5 search …   ▸ ${HUB}`,
];
const title = " ▓▒░ RELIC5·IMPORT ░▒▓ ";
const w = Math.max(...lines.map((l) => Bun.stringWidth(l)));
const b = ok ? cyan : amber;
console.log(b("╭─") + bold(pink(title)) + b("─".repeat(w + 1 - Bun.stringWidth(title)) + "╮"));
for (const l of lines) console.log(b("│") + " " + l + " ".repeat(w - Bun.stringWidth(l)) + " " + b("│"));
console.log(b("╰" + "─".repeat(w + 2) + "╯"));
process.exit(fails > 0 ? 1 : sync.exitCode);
